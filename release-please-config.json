{
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "pull-request-title-pattern": "chore(release): ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/openboard/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/contract/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/driver-postgres/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/driver-sql/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/driver-sqlite/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/ports/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tools/bench/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tools/conformance/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/server/openapi.json",
          "jsonpath": "$.info.version"
        }
      ]
    }
  }
}
