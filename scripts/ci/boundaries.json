{
  "$comment": "The allow-list graph of docs/codebase.md 3.1, read by scripts/ci/boundaries.ts. Keys are workspace directories, or a directory inside one (the longest key wins). Names in may and types are workspace directory names. Owner-reviewed: never edit this file to make a change pass.",
  "graph": {
    "packages/contract": { "may": [], "external": ["@sinclair/typebox"] },
    "packages/core": { "may": ["contract"], "external": [] },
    "packages/ports": { "may": ["contract"], "types": ["core"], "external": [] },
    "packages/ports/testkit": { "may": ["contract", "core", "ports"], "external": ["bun:test"] },
    "packages/driver-sql": { "may": ["contract", "core", "ports"], "external": [] },
    "packages/driver-sqlite": {
      "may": ["driver-sql", "contract", "core", "ports"],
      "external": ["bun:sqlite", "node:fs", "node:path"]
    },
    "packages/driver-postgres": { "may": ["driver-sql", "contract", "core", "ports"], "external": ["bun"] },
    "packages/server": { "may": ["contract", "core", "ports"], "external": ["bun", "node:crypto", "node:path"] },
    "packages/server/test/support": {
      "may": ["contract", "core", "ports", "driver-sqlite", "driver-postgres"],
      "external": ["bun", "node:crypto", "node:path"]
    },
    "packages/sdk": { "may": ["contract"], "external": [] },
    "packages/cli": { "may": ["sdk", "contract"], "external": ["node:*"] },
    "apps/openboard": {
      "may": ["server", "cli", "ports", "driver-sqlite", "driver-postgres", "contract"],
      "external": ["bun", "node:*"]
    },
    "apps/web": {
      "may": ["sdk", "contract"],
      "external": [
        "react",
        "react-dom",
        "@tanstack/react-router",
        "@tanstack/react-query",
        "@tanstack/react-virtual",
        "geist"
      ]
    },
    "tools/conformance": {
      "may": ["server", "ports", "driver-sqlite", "driver-postgres", "contract"],
      "external": ["@vercel/board", "node:*"]
    },
    "tools/bench": {
      "may": ["server", "ports", "driver-sqlite", "driver-postgres", "sdk", "contract"],
      "external": ["node:*"]
    }
  },
  "drivers": {
    "$comment": "docs/codebase.md 3.1 universal rules: a driver is imported only by these composition roots and by its own workspace (its tests).",
    "workspaces": ["driver-sqlite", "driver-postgres"],
    "compositionRoots": [
      "apps/openboard/src/compose.ts",
      "packages/server/test/support/drivers.ts",
      "tools/conformance/src/drivers.ts",
      "tools/bench/src/drivers.ts"
    ]
  },
  "dbClients": {
    "$comment": "docs/codebase.md 3.2: a database client is opened only inside its own driver, in any file of any workspace. A client without names is a whole module; one with names is those exports of the module, reached by import or Bun's global; outside the owner, a run-time import() or require() of the module and an export * from it are refused.",
    "clients": [
      { "module": "bun:sqlite", "workspace": "driver-sqlite" },
      { "module": "bun", "names": ["SQL", "sql", "postgres"], "workspace": "driver-postgres" }
    ]
  },
  "denyTerms": ["armada", "slack", "linear", "notion", "discord", "granite"],
  "tests": { "external": ["bun:test", "@openboard/ports/testkit"] }
}
